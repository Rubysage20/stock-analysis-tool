/* Stock Analysis Tool - Professional Styling */

:root {
  --primary-color: #1e3a8a;
  --primary-light: #3b5998;
  --primary-dark: #0f172a;
  --accent-color: #60a5fa;
  --success-color: #22c55e;
  --danger-color: #ef4444;
  --warning-color: #f59e0b;
  --text-primary: #1e293b;
  --text-secondary: #64748b;
  --background: #ffffff;
  --background-light: #f8fafc;
  --border-color: #e2e8f0;
  --shadow: rgba(15, 23, 42, 0.1);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
  line-height: 1.6;
  color: var(--text-primary);
  background: var(--background-light);
}

.App {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* Header */
.header {
  background: linear-gradient(135deg, #1e40af 0%, #3b82f6 50%, #2563eb 100%);
  padding: 2rem;
  text-align: center;
  color: white;
  box-shadow: 0 4px 20px rgba(30, 64, 175, 0.3);
}

.header-content h1 {
  font-size: 2.5rem;
  font-weight: 900;
  letter-spacing: 3px;
  margin-bottom: 0.5rem;
}

.header-content p {
  font-size: 1.1rem;
  opacity: 0.9;
  letter-spacing: 1px;
}

/* Navigation */
.nav-bar {
  background: var(--primary-dark);
  display: flex;
  justify-content: center;
  gap: 0;
  box-shadow: 0 2px 10px var(--shadow);
  position: sticky;
  top: 0;
  z-index: 1000;
}

.nav-bar button {
  background: none;
  border: none;
  color: #cbd5e1;
  padding: 1rem 2rem;
  cursor: pointer;
  font-size: 1rem;
  font-weight: 500;
  transition: all 0.3s ease;
  border-bottom: 3px solid transparent;
}

.nav-bar button:hover {
  background: rgba(59, 130, 246, 0.15);
  color: #ffffff;
}

.nav-bar button.active {
  background: rgba(59, 130, 246, 0.25);
  color: #ffffff;
  border-bottom-color: var(--accent-color);
}

/* Main Content */
.main-content {
  flex: 1;
  max-width: 1400px;
  width: 100%;
  margin: 0 auto;
  padding: 2rem;
}

/* Search Section */
.search-form {
  margin-bottom: 2rem;
}

.search-input-group {
  display: flex;
  align-items: center;
  gap: 1rem;
  background: white;
  padding: 1rem;
  border-radius: 12px;
  box-shadow: 0 2px 8px var(--shadow);
  border: 2px solid var(--border-color);
  transition: border-color 0.3s ease;
}

.search-input-group:focus-within {
  border-color: var(--accent-color);
}

.search-input-group svg {
  color: var(--text-secondary);
}

.search-input-group input {
  flex: 1;
  border: none;
  outline: none;
  font-size: 1.1rem;
  color: var(--text-primary);
}

.search-input-group button {
  background: var(--primary-color);
  color: white;
  border: none;
  padding: 0.8rem 2rem;
  border-radius: 8px;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s ease;
}

.search-input-group button:hover:not(:disabled) {
  background: var(--primary-light);
  transform: translateY(-2px);
}

.search-input-group button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

/* Error Message */
.error-message {
  background: #fef2f2;
  border-left: 4px solid var(--danger-color);
  padding: 1rem;
  border-radius: 8px;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: var(--danger-color);
  margin-bottom: 1rem;
}

/* Stock Results */
.stock-results {
  display: grid;
  gap: 2rem;
}

/* Stock Card */
.stock-card {
  background: white;
  padding: 2rem;
  border-radius: 12px;
  box-shadow: 0 2px 8px var(--shadow);
}

.stock-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.5rem;
}

.stock-header h2 {
  font-size: 2rem;
  color: var(--primary-color);
}

.stock-actions {
  display: flex;
  gap: 0.5rem;
}

.btn-secondary {
  background: var(--background-light);
  border: 2px solid var(--border-color);
  color: var(--primary-color);
  padding: 0.5rem 1rem;
  border-radius: 8px;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  cursor: pointer;
  font-weight: 600;
  transition: all 0.3s ease;
}

.btn-secondary:hover {
  border-color: var(--primary-color);
  background: var(--primary-color);
  color: white;
}

.stock-price {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1.5rem;
}

.price {
  font-size: 3rem;
  font-weight: 700;
  color: var(--primary-color);
}

.change {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.5rem 1rem;
  border-radius: 8px;
  font-weight: 600;
  font-size: 1.1rem;
}

.change.positive {
  background: #dcfce7;
  color: var(--success-color);
}

.change.negative {
  background: #fee2e2;
  color: var(--danger-color);
}

.stock-details {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 1rem;
}

.detail-item {
  display: flex;
  flex-direction: column;
  gap: 0.3rem;
}

.detail-item span {
  color: var(--text-secondary);
  font-size: 0.9rem;
}

.detail-item strong {
  color: var(--text-primary);
  font-size: 1.1rem;
}

/* Recommendation Card */
.recommendation-card {
  background: white;
  padding: 2rem;
  border-radius: 12px;
  box-shadow: 0 2px 8px var(--shadow);
}

.recommendation-card h3 {
  color: var(--primary-color);
  margin-bottom: 1rem;
  font-size: 1.5rem;
}

.recommendation-badge {
  display: inline-block;
  padding: 0.8rem 2rem;
  border-radius: 30px;
  color: white;
  font-weight: 700;
  font-size: 1.2rem;
  margin-bottom: 1rem;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.recommendation-desc {
  color: var(--text-secondary);
  margin-bottom: 2rem;
  font-size: 1.1rem;
}

.indicators-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  gap: 1.5rem;
  margin-bottom: 2rem;
}

.indicator {
  background: var(--background-light);
  padding: 1.5rem;
  border-radius: 8px;
  text-align: center;
}

.indicator h4 {
  color: var(--text-secondary);
  font-size: 0.9rem;
  margin-bottom: 0.5rem;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.indicator-value {
  font-size: 1.8rem;
  font-weight: 700;
  color: var(--primary-color);
  margin-bottom: 0.5rem;
}

.indicator-signal {
  color: var(--text-secondary);
  font-size: 0.9rem;
}

.signals {
  margin-top: 1.5rem;
}

.signals h4 {
  font-size: 1.1rem;
  margin-bottom: 0.8rem;
}

.bullish-title {
  color: var(--success-color);
}

.bearish-title {
  color: var(--danger-color);
}

.signals ul {
  list-style: none;
  padding-left: 0;
}

.signals li {
  padding: 0.5rem 0;
  padding-left: 1.5rem;
  position: relative;
}

.signals li::before {
  content: '•';
  position: absolute;
  left: 0;
  font-size: 1.5rem;
}

.bullish-title + ul li::before {
  color: var(--success-color);
}

.bearish-title + ul li::before {
  color: var(--danger-color);
}

/* Chart Card */
.chart-card {
  background: white;
  padding: 2rem;
  border-radius: 12px;
  box-shadow: 0 2px 8px var(--shadow);
}

.chart-card h3 {
  color: var(--primary-color);
  margin-bottom: 1.5rem;
}

/* Watchlist */
.watchlist-section h2,
.portfolio-section h2 {
  color: var(--primary-color);
  margin-bottom: 2rem;
  font-size: 2rem;
}

.empty-message {
  text-align: center;
  color: var(--text-secondary);
  padding: 3rem;
  background: white;
  border-radius: 12px;
  font-size: 1.1rem;
}

.watchlist-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 1.5rem;
}

.watchlist-card {
  background: white;
  padding: 1.5rem;
  border-radius: 12px;
  box-shadow: 0 2px 8px var(--shadow);
  border: 1px solid var(--border-color);
  transition: all 0.3s ease;
}

.watchlist-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 6px 16px rgba(30, 58, 138, 0.2);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1rem;
}

.card-header h3 {
  color: var(--primary-color);
  font-size: 1.5rem;
}

.btn-icon {
  background: none;
  border: none;
  color: var(--danger-color);
  cursor: pointer;
  padding: 0.5rem;
  border-radius: 4px;
  transition: background 0.3s ease;
}

.btn-icon:hover {
  background: #fee2e2;
}

.company-name {
  color: var(--text-secondary);
  margin-bottom: 1rem;
}

.price-info {
  display: flex;
  justify-content: space-between;
  padding: 0.5rem 0;
}

.price-info .label {
  color: var(--text-secondary);
}

.price-info .value {
  font-weight: 600;
  color: var(--primary-color);
}

.notes {
  margin-top: 1rem;
  padding-top: 1rem;
  border-top: 1px solid var(--border-color);
  color: var(--text-secondary);
  font-style: italic;
}

/* Portfolio */
.portfolio-summary {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 1.5rem;
  margin-bottom: 2rem;
}

.summary-item {
  background: white;
  padding: 1.5rem;
  border-radius: 12px;
  box-shadow: 0 2px 8px var(--shadow);
  text-align: center;
}

.summary-item span {
  display: block;
  color: var(--text-secondary);
  font-size: 0.9rem;
  margin-bottom: 0.5rem;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.summary-item strong {
  font-size: 2rem;
  color: var(--primary-color);
}

.summary-item .value {
  color: var(--primary-color);
}

.summary-item .profit {
  color: var(--success-color);
}

.summary-item .loss {
  color: var(--danger-color);
}

.portfolio-table {
  background: white;
  border-radius: 12px;
  box-shadow: 0 2px 8px var(--shadow);
  overflow: hidden;
}

.portfolio-table table {
  width: 100%;
  border-collapse: collapse;
}

.portfolio-table th {
  background: var(--primary-color);
  color: white;
  padding: 1rem;
  text-align: left;
  font-weight: 600;
  text-transform: uppercase;
  font-size: 0.9rem;
  letter-spacing: 1px;
}

.portfolio-table td {
  padding: 1rem;
  border-bottom: 1px solid var(--border-color);
}

.portfolio-table tr:hover {
  background: var(--background-light);
}

.portfolio-table .profit {
  color: var(--success-color);
  font-weight: 600;
}

.portfolio-table .loss {
  color: var(--danger-color);
  font-weight: 600;
}

/* Footer */
.footer {
  background: var(--primary-dark);
  color: #cbd5e1;
  text-align: center;
  padding: 2rem;
  margin-top: 4rem;
}

/* Responsive */
@media (max-width: 768px) {
  .header-content h1 {
    font-size: 2rem;
  }

  .nav-bar {
    flex-direction: column;
  }

  .stock-header {
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .price {
    font-size: 2rem;
  }

  .watchlist-grid {
    grid-template-columns: 1fr;
  }

  .portfolio-table {
    overflow-x: auto;
  }
}

import React, { useState, useEffect } from 'react';
import axios from 'axios';
import { LineChart, Line, XAxis, YAxis, CartesianGrid, Tooltip, Legend, ResponsiveContainer } from 'recharts';
import { Search, TrendingUp, TrendingDown, DollarSign, Plus, Trash2, AlertCircle } from 'lucide-react';
import './App.css';

const API_URL = 'http://localhost:5000/api';

function App() {
  const [activeTab, setActiveTab] = useState('search');
  const [searchTerm, setSearchTerm] = useState('');
  const [selectedStock, setSelectedStock] = useState(null);
  const [stockData, setStockData] = useState(null);
  const [chartData, setChartData] = useState([]);
  const [recommendation, setRecommendation] = useState(null);
  const [watchlist, setWatchlist] = useState([]);
  const [portfolio, setPortfolio] = useState({ positions: [], summary: {} });
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState(null);

  // Fetch watchlist on component mount
  useEffect(() => {
    if (activeTab === 'watchlist') {
      fetchWatchlist();
    }
  }, [activeTab]);

  // Fetch portfolio on component mount
  useEffect(() => {
    if (activeTab === 'portfolio') {
      fetchPortfolio();
    }
  }, [activeTab]);

  // Search for stock
  const handleSearch = async (e) => {
    e.preventDefault();
    if (!searchTerm.trim()) return;

    setLoading(true);
    setError(null);

    try {
      // Get stock quote
      const quoteRes = await axios.get(`${API_URL}/stocks/quote/${searchTerm}`);
      setStockData(quoteRes.data);
      setSelectedStock(searchTerm.toUpperCase());

      // Get chart data
      const chartRes = await axios.get(`${API_URL}/stocks/chart/${searchTerm}`);
      setChartData(chartRes.data.slice(-30)); // Last 30 days

      // Get recommendation
      const recRes = await axios.get(`${API_URL}/stocks/recommendation/${searchTerm}`);
      setRecommendation(recRes.data);
    } catch (err) {
      setError(err.response?.data?.error || 'Error fetching stock data');
      setStockData(null);
      setRecommendation(null);
    } finally {
      setLoading(false);
    }
  };

  // Add to watchlist
  const addToWatchlist = async () => {
    if (!selectedStock) return;

    try {
      await axios.post(`${API_URL}/watchlist`, {
        symbol: selectedStock,
        companyName: stockData.symbol,
        currentPrice: stockData.price
      });
      alert('Added to watchlist!');
    } catch (err) {
      alert(err.response?.data?.error || 'Error adding to watchlist');
    }
  };

  // Fetch watchlist
  const fetchWatchlist = async () => {
    try {
      const res = await axios.get(`${API_URL}/watchlist`);
      setWatchlist(res.data);
    } catch (err) {
      console.error('Error fetching watchlist:', err);
    }
  };

  // Remove from watchlist
  const removeFromWatchlist = async (symbol) => {
    try {
      await axios.delete(`${API_URL}/watchlist/${symbol}`);
      fetchWatchlist();
    } catch (err) {
      alert('Error removing from watchlist');
    }
  };

  // Fetch portfolio
  const fetchPortfolio = async () => {
    try {
      const res = await axios.get(`${API_URL}/portfolio`);
      setPortfolio(res.data);
    } catch (err) {
      console.error('Error fetching portfolio:', err);
    }
  };

  // Add to portfolio
  const addToPortfolio = () => {
    const shares = prompt('Enter number of shares:');
    const purchasePrice = prompt('Enter purchase price per share:');
    const purchaseDate = prompt('Enter purchase date (YYYY-MM-DD):');

    if (!shares || !purchasePrice || !purchaseDate) return;

    axios.post(`${API_URL}/portfolio`, {
      symbol: selectedStock,
      companyName: stockData.symbol,
      shares: parseFloat(shares),
      purchasePrice: parseFloat(purchasePrice),
      purchaseDate
    })
    .then(() => {
      alert('Added to portfolio!');
      fetchPortfolio();
    })
    .catch(err => {
      alert(err.response?.data?.error || 'Error adding to portfolio');
    });
  };

  // Remove from portfolio
  const removeFromPortfolio = async (id) => {
    if (!window.confirm('Remove this position?')) return;

    try {
      await axios.delete(`${API_URL}/portfolio/${id}`);
      fetchPortfolio();
    } catch (err) {
      alert('Error removing from portfolio');
    }
  };

  return (
    <div className="App">
      {/* Header */}
      <header className="header">
        <div className="header-content">
          <h1>STOCK ANALYSIS TOOL</h1>
          <p>AI-Powered Investment Assistant</p>
        </div>
      </header>

      {/* Navigation */}
      <nav className="nav-bar">
        <button 
          className={activeTab === 'search' ? 'active' : ''} 
          onClick={() => setActiveTab('search')}
        >
          Search & Analyze
        </button>
        <button 
          className={activeTab === 'watchlist' ? 'active' : ''} 
          onClick={() => setActiveTab('watchlist')}
        >
          Watchlist
        </button>
        <button 
          className={activeTab === 'portfolio' ? 'active' : ''} 
          onClick={() => setActiveTab('portfolio')}
        >
          Portfolio
        </button>
      </nav>

      {/* Main Content */}
      <main className="main-content">
        {activeTab === 'search' && (
          <div className="search-section">
            {/* Search Form */}
            <form onSubmit={handleSearch} className="search-form">
              <div className="search-input-group">
                <Search size={20} />
                <input
                  type="text"
                  placeholder="Enter stock symbol (e.g., AAPL, MSFT, TSLA)"
                  value={searchTerm}
                  onChange={(e) => setSearchTerm(e.target.value.toUpperCase())}
                />
                <button type="submit" disabled={loading}>
                  {loading ? 'Analyzing...' : 'Analyze'}
                </button>
              </div>
            </form>

            {error && (
              <div className="error-message">
                <AlertCircle size={20} />
                {error}
              </div>
            )}

            {/* Stock Data Display */}
            {stockData && (
              <div className="stock-results">
                {/* Stock Quote Card */}
                <div className="stock-card">
                  <div className="stock-header">
                    <h2>{stockData.symbol}</h2>
                    <div className="stock-actions">
                      <button onClick={addToWatchlist} className="btn-secondary">
                        <Plus size={16} /> Watchlist
                      </button>
                      <button onClick={addToPortfolio} className="btn-secondary">
                        <Plus size={16} /> Portfolio
                      </button>
                    </div>
                  </div>
                  
                  <div className="stock-price">
                    <span className="price">${stockData.price}</span>
                    <span className={`change ${stockData.change >= 0 ? 'positive' : 'negative'}`}>
                      {stockData.change >= 0 ? <TrendingUp size={16} /> : <TrendingDown size={16} />}
                      {stockData.changePercent}
                    </span>
                  </div>

                  <div className="stock-details">
                    <div className="detail-item">
                      <span>Open</span>
                      <strong>${stockData.open}</strong>
                    </div>
                    <div className="detail-item">
                      <span>High</span>
                      <strong>${stockData.high}</strong>
                    </div>
                    <div className="detail-item">
                      <span>Low</span>
                      <strong>${stockData.low}</strong>
                    </div>
                    <div className="detail-item">
                      <span>Volume</span>
                      <strong>{stockData.volume.toLocaleString()}</strong>
                    </div>
                  </div>
                </div>

                {/* Recommendation Card */}
                {recommendation && (
                  <div className="recommendation-card">
                    <h3>Recommendation</h3>
                    <div 
                      className="recommendation-badge"
                      style={{ backgroundColor: recommendation.recommendation.color }}
                    >
                      {recommendation.recommendation.action}
                    </div>
                    <p className="recommendation-desc">
                      {recommendation.recommendation.description}
                    </p>
                    
                    <div className="indicators-grid">
                      <div className="indicator">
                        <h4>RSI</h4>
                        <p className="indicator-value">{recommendation.indicators.rsi.value.toFixed(2)}</p>
                        <p className="indicator-signal">{recommendation.indicators.rsi.signal}</p>
                      </div>
                      <div className="indicator">
                        <h4>MACD</h4>
                        <p className="indicator-value">{recommendation.indicators.macd.macd.toFixed(2)}</p>
                        <p className="indicator-signal">{recommendation.indicators.macd.interpretation.signal}</p>
                      </div>
                      <div className="indicator">
                        <h4>Trend</h4>
                        <p className="indicator-value">{recommendation.indicators.trend.type}</p>
                        <p className="indicator-signal">{recommendation.indicators.trend.strength}</p>
                      </div>
                    </div>

                    {recommendation.analysis.bullishSignals.length > 0 && (
                      <div className="signals">
                        <h4 className="bullish-title">Bullish Signals</h4>
                        <ul>
                          {recommendation.analysis.bullishSignals.map((signal, idx) => (
                            <li key={idx}>{signal}</li>
                          ))}
                        </ul>
                      </div>
                    )}

                    {recommendation.analysis.bearishSignals.length > 0 && (
                      <div className="signals">
                        <h4 className="bearish-title">Bearish Signals</h4>
                        <ul>
                          {recommendation.analysis.bearishSignals.map((signal, idx) => (
                            <li key={idx}>{signal}</li>
                          ))}
                        </ul>
                      </div>
                    )}
                  </div>
                )}

                {/* Chart */}
                {chartData.length > 0 && (
                  <div className="chart-card">
                    <h3>30-Day Price Chart</h3>
                    <ResponsiveContainer width="100%" height={300}>
                      <LineChart data={chartData}>
                        <CartesianGrid strokeDasharray="3 3" />
                        <XAxis dataKey="date" />
                        <YAxis domain={['auto', 'auto']} />
                        <Tooltip />
                        <Legend />
                        <Line type="monotone" dataKey="close" stroke="#2563eb" strokeWidth={2} />
                      </LineChart>
                    </ResponsiveContainer>
                  </div>
                )}
              </div>
            )}
          </div>
        )}

        {/* Watchlist Tab */}
        {activeTab === 'watchlist' && (
          <div className="watchlist-section">
            <h2>Your Watchlist</h2>
            {watchlist.length === 0 ? (
              <p className="empty-message">No stocks in watchlist. Search for stocks and add them!</p>
            ) : (
              <div className="watchlist-grid">
                {watchlist.map((item) => (
                  <div key={item._id} className="watchlist-card">
                    <div className="card-header">
                      <h3>{item.symbol}</h3>
                      <button 
                        onClick={() => removeFromWatchlist(item.symbol)}
                        className="btn-icon"
                      >
                        <Trash2 size={16} />
                      </button>
                    </div>
                    <p className="company-name">{item.companyName}</p>
                    <div className="price-info">
                      <span className="label">Current Price:</span>
                      <span className="value">${item.currentPrice?.toFixed(2)}</span>
                    </div>
                    {item.targetPrice && (
                      <div className="price-info">
                        <span className="label">Target Price:</span>
                        <span className="value">${item.targetPrice}</span>
                      </div>
                    )}
                    {item.notes && (
                      <p className="notes">{item.notes}</p>
                    )}
                  </div>
                ))}
              </div>
            )}
          </div>
        )}

        {/* Portfolio Tab */}
        {activeTab === 'portfolio' && (
          <div className="portfolio-section">
            <h2>Your Portfolio</h2>
            
            {portfolio.summary.totalValue && (
              <div className="portfolio-summary">
                <div className="summary-item">
                  <span>Total Value</span>
                  <strong className="value">${portfolio.summary.totalValue}</strong>
                </div>
                <div className="summary-item">
                  <span>Total Cost</span>
                  <strong>${portfolio.summary.totalCost}</strong>
                </div>
                <div className="summary-item">
                  <span>Profit/Loss</span>
                  <strong className={parseFloat(portfolio.summary.totalProfitLoss) >= 0 ? 'profit' : 'loss'}>
                    ${portfolio.summary.totalProfitLoss} ({portfolio.summary.totalProfitLossPercent}%)
                  </strong>
                </div>
              </div>
            )}

            {portfolio.positions.length === 0 ? (
              <p className="empty-message">No positions in portfolio. Add stocks from the search tab!</p>
            ) : (
              <div className="portfolio-table">
                <table>
                  <thead>
                    <tr>
                      <th>Symbol</th>
                      <th>Shares</th>
                      <th>Purchase Price</th>
                      <th>Current Price</th>
                      <th>Total Value</th>
                      <th>Profit/Loss</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    {portfolio.positions.map((position) => (
                      <tr key={position._id}>
                        <td><strong>{position.symbol}</strong></td>
                        <td>{position.shares}</td>
                        <td>${position.purchasePrice.toFixed(2)}</td>
                        <td>${position.currentPrice?.toFixed(2)}</td>
                        <td>${(position.shares * position.currentPrice).toFixed(2)}</td>
                        <td className={position.profitLoss >= 0 ? 'profit' : 'loss'}>
                          ${position.profitLoss?.toFixed(2)} ({position.profitLossPercent?.toFixed(2)}%)
                        </td>
                        <td>
                          <button 
                            onClick={() => removeFromPortfolio(position._id)}
                            className="btn-icon"
                          >
                            <Trash2 size={16} />
                          </button>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
          </div>
        )}
      </main>

      {/* Footer */}
      <footer className="footer">
        <p>&copy; 2025 Stock Analysis Tool | Built by Valerie Dawson</p>
      </footer>
    </div>
  );
}

export default App;
